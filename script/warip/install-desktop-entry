#!/usr/bin/env bash
#
# script/warip/install-desktop-entry - install the warip desktop entry for the
# current user, so GNOME shows "warip" (name and icon) in the dock, app grid
# and Alt+Tab instead of the raw app ID.
#
# Usage:
#   script/warip/install-desktop-entry [binary]
#       binary defaults to target/release/warip in this repository.

set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")"/../.. && pwd)"
TEMPLATE="$REPO_ROOT/app/channels/warip/dev.warip.Warip.desktop"
APPS_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/applications"
TARGET="$APPS_DIR/dev.warip.Warip.desktop"

binary="$(readlink -f "${1:-$REPO_ROOT/target/release/warip}")"
if [ ! -x "$binary" ]; then
  echo "error: warip binary not found at $binary (build it first)" >&2
  exit 1
fi

mkdir -p "$APPS_DIR"
sed "s|@WARIP_BIN@|$binary|" "$TEMPLATE" >"$TARGET"

if command -v desktop-file-validate >/dev/null; then
  desktop-file-validate "$TARGET"
fi
if command -v update-desktop-database >/dev/null; then
  update-desktop-database "$APPS_DIR"
fi

echo "Installed $TARGET (Exec=$binary)"
